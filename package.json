{
  "name": "@tpsdev-ai/bob",
  "version": "0.2.0",
  "type": "module",
  "description": "Bob — office-agent shell. Hire a Bob, give them a role, and they show up to work.",
  "bin": {
    "bob": "./bin/bob"
  },
  "exports": {
    "./capabilities/*": "./dist/capabilities/*/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "roles"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
