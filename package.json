{
  "name": "@tpsdev-ai/bob",
  "version": "0.2.0",
  "packageManager": "bun@1.4.4",
  "type": "module",
  "description": "Bob — office-agent shell. Hire a Bob, give them a role, and they show up to work.",
  "bin": {
    "bob": "./bin/bob"
  },
  "exports": {
    "./capabilities/*": "./dist/capabilities/*/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "roles",
    "positions"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit && tsc -p test/types --noEmit",
    "test": "bun run build && bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:reachy-isolation": "bun scripts/check-reachy-isolation.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "croner": "10.0.1",
    "discord.js": "14.28.0",
    "htmlparser2": "12.0.0",
    "typebox": "1.4.3",
    "undici": "8.12.3",
    "yaml": "2.9.1",
    "@earendil-works/pi-ai": "0.84.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-client": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-protocol": "0.84.3",
    "@earendil-works/pi-telemetry": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "ws": "8.22.1",
    "@discordjs/rest": "2.6.3",
    "protobufjs": "7.6.6",
    "brace-expansion": "5.0.12",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "keywords": [
    "agent",
    "office-agent",
    "ea",
    "pi-coding-agent",
    "discord-bot",
    "flair",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "tpsdev-ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/tpsdev-ai/bob.git"
  },
  "homepage": "https://github.com/tpsdev-ai/bob#readme",
  "bugs": "https://github.com/tpsdev-ai/bob/issues"
}
