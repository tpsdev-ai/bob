  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "ws": "^8.21.0",
    "@discordjs/rest": "^2.6.3",
    "protobufjs": "^7.6.5",
    "brace-expansion": "^5.0.9",
    "undici": "^8.9.0"
  },
  "keywords": [
    "agent",
